<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BetterModMenu</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);BetterModMenu.Tests\**;decompiled\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <PackageModOnBuild Condition="'$(PackageModOnBuild)' == ''">false</PackageModOnBuild>
    <IncludeCloudFeatures Condition="'$(IncludeCloudFeatures)' == ''">false</IncludeCloudFeatures>
    <CloudPackageSuffix Condition="'$(IncludeCloudFeatures)' == 'true'">_cloud</CloudPackageSuffix>
    <CloudPackageSuffix Condition="'$(IncludeCloudFeatures)' != 'true'"></CloudPackageSuffix>
    <DefineConstants Condition="'$(IncludeCloudFeatures)' == 'true'">$(DefineConstants);BETTERMODMENU_CLOUD_FEATURES</DefineConstants>
    <ArtifactsDir Condition="'$(ArtifactsDir)' == ''">$(ProjectDir)artifacts\</ArtifactsDir>
    <PrepareWorkshopWorkspaceOnBuild Condition="'$(PrepareWorkshopWorkspaceOnBuild)' == ''">false</PrepareWorkshopWorkspaceOnBuild>
    <Sts2DllPath Condition="'$(Sts2DllPath)' == '' and '$(STS2_DLL_PATH)' != ''">$(STS2_DLL_PATH)</Sts2DllPath>
    <ModUploaderWorkshopDir Condition="'$(ModUploaderWorkshopDir)' == '' and '$(MOD_UPLOADER_WORKSHOP_DIR)' != ''">$(MOD_UPLOADER_WORKSHOP_DIR)</ModUploaderWorkshopDir>
  </PropertyGroup>

  <Target Name="CheckSts2Dll" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Sts2DllPath)' == '' or !Exists('$(Sts2DllPath)')" Text="sts2.dll not found. Set STS2_DLL_PATH or pass -p:Sts2DllPath=&quot;C:\path\to\sts2.dll&quot; when building BetterModMenu." />
  </Target>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DllPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>
  <!-- Custom Target to run after Build -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(PackageModOnBuild)' == 'true'">
    <PropertyGroup>
      <!-- Extract version from JSON -->
      <JsonFileContent>$([System.IO.File]::ReadAllText('$(ProjectDir)BetterModMenu.json'))</JsonFileContent>
      <ModVersionRegex>&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;</ModVersionRegex>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($(JsonFileContent), $(ModVersionRegex)).Groups[1].Value)</ModVersion>
      <BaseZipName>$(AssemblyName)_v$(ModVersion)$(CloudPackageSuffix)</BaseZipName>
      <ModStagingDir>$(ArtifactsDir)$(BaseZipName)\</ModStagingDir>
      <ZipFilePath>$(ArtifactsDir)$(BaseZipName).zip</ZipFilePath>
    </PropertyGroup>

    <!-- Prepare the staging directory for the zip -->
    <MakeDir Directories="$(ArtifactsDir)" />
    <RemoveDir Directories="$(ModStagingDir)" />
    <MakeDir Directories="$(ModStagingDir)" />

    <!-- Copy the DLL and JSON file to the staging directory -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModStagingDir)" />
    <Copy SourceFiles="$(ProjectDir)BetterModMenu.json" DestinationFolder="$(ModStagingDir)" />

    <!-- Create the zip file -->
    <ZipDirectory SourceDirectory="$(ModStagingDir)" DestinationFile="$(ZipFilePath)" Overwrite="true" />
    
    <!-- Clean up the staging directory -->
    <RemoveDir Directories="$(ModStagingDir)" />
    
    <Message Text="Successfully packaged: $(ZipFilePath)" Importance="High" />
  </Target>

  <Target Name="PrepareWorkshopWorkspace" AfterTargets="Build" Condition="'$(PrepareWorkshopWorkspaceOnBuild)' == 'true'">
    <PropertyGroup>
      <WorkshopWorkspaceDir>$(ArtifactsDir)workshop\BetterModMenu\</WorkshopWorkspaceDir>
      <WorkshopContentDir>$(WorkshopWorkspaceDir)content\</WorkshopContentDir>
      <WorkshopScreenshotsDir>$(WorkshopWorkspaceDir)screenshots\</WorkshopScreenshotsDir>
      <WorkshopPreviewImage>$(ProjectDir)workshop\image.png</WorkshopPreviewImage>
    </PropertyGroup>
    <ItemGroup>
      <WorkshopScreenshots Include="$(ProjectDir)workshop\screenshots\*.*" />
    </ItemGroup>

    <Error Condition="!Exists('$(WorkshopPreviewImage)')" Text="Steam Workshop preview image not found. Add workshop\image.png before preparing the uploader workspace." />

    <MakeDir Directories="$(WorkshopContentDir)" />
    <MakeDir Directories="$(WorkshopScreenshotsDir)" Condition="'@(WorkshopScreenshots)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(WorkshopContentDir)" />
    <Copy SourceFiles="$(ProjectDir)BetterModMenu.json" DestinationFolder="$(WorkshopContentDir)" />
    <Copy SourceFiles="$(ProjectDir)workshop\workshop.json" DestinationFolder="$(WorkshopWorkspaceDir)" />
    <Copy SourceFiles="$(WorkshopPreviewImage)" DestinationFolder="$(WorkshopWorkspaceDir)" />
    <Copy SourceFiles="@(WorkshopScreenshots)" DestinationFolder="$(WorkshopScreenshotsDir)" Condition="'@(WorkshopScreenshots)' != ''" />

    <Message Text="Prepared Steam Workshop uploader workspace: $(WorkshopWorkspaceDir)" Importance="High" />
  </Target>

  <Target Name="StageModUploaderWorkshopContent" AfterTargets="Build" Condition="'$(ModUploaderWorkshopDir)' != ''">
    <PropertyGroup>
      <NormalizedModUploaderWorkshopDir>$([MSBuild]::EnsureTrailingSlash('$(ModUploaderWorkshopDir)'))</NormalizedModUploaderWorkshopDir>
      <ModUploaderWorkshopContentDir>$(NormalizedModUploaderWorkshopDir)content\</ModUploaderWorkshopContentDir>
    </PropertyGroup>
    <ItemGroup>
      <ModUploaderWorkshopContentFiles Include="$(ModUploaderWorkshopContentDir)*" />
      <UnexpectedModUploaderWorkshopContent Include="@(ModUploaderWorkshopContentFiles)" Exclude="$(ModUploaderWorkshopContentDir)$(TargetFileName);$(ModUploaderWorkshopContentDir)BetterModMenu.json" />
    </ItemGroup>

    <Error Condition="!Exists('$(NormalizedModUploaderWorkshopDir)workshop.json')" Text="ModUploaderWorkshopDir must point to an existing ModUploader workshop root containing workshop.json. Do not pass the content folder." />
    <Warning Condition="'@(UnexpectedModUploaderWorkshopContent)' != ''" Text="ModUploader content folder contains extra files that will be left in place: @(UnexpectedModUploaderWorkshopContent)" />
    <MakeDir Directories="$(ModUploaderWorkshopContentDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModUploaderWorkshopContentDir)" />
    <Copy SourceFiles="$(ProjectDir)BetterModMenu.json" DestinationFolder="$(ModUploaderWorkshopContentDir)" />

    <Message Text="Staged ModUploader workshop content: $(NormalizedModUploaderWorkshopDir)" Importance="High" />
  </Target>
</Project>
